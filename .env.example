# Copiez ce fichier en `.env` (ignoré par git) et renseignez vos propres valeurs.
# Ne commitez jamais de clés réelles.

# PostgreSQL local (voir DEVELOPPEMENT.md)
DATABASE_URL=postgresql://postgres@localhost:5432/anif

# API
PORT=5000
NODE_ENV=development

# Clerk — clés de VOTRE instance de développement (dashboard.clerk.com → API Keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Adresse(s) e-mail vérifiée(s) autorisée(s) à devenir le premier N1
ITSM_BOOTSTRAP_ADMIN_EMAILS=

# Archive des habilitations, mode développement uniquement (sans archive externe)
ITSM_ROLE_ARCHIVE_MODE=development-db

# Origines autorisées à appeler l’API depuis un autre domaine (vide = même origine uniquement)
CORS_ALLOWED_ORIGINS=

# Frontend (Vite)
BASE_PATH=/
# Relais local /api vers l’API (inutile sur Replit)
API_PROXY_TARGET=http://localhost:5000
